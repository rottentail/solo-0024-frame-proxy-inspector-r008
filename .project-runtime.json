{
  "schema_version": 1,
  "language": "python",
  "project_shape": "backend",
  "source_extensions": [
    ".py"
  ],
  "build_command": "python3 -m compileall -q src tools",
  "testing": "deferred",
  "workflow_checks": [
    {
      "workflow_id": "register-video-clip",
      "command": "PYTHONPATH=src:. python3 tools/check_clip_intake.py"
    },
    {
      "workflow_id": "index-shot-boundaries",
      "command": "PYTHONPATH=src:. python3 tools/check_shot_index.py"
    },
    {
      "workflow_id": "create-contact-sheet",
      "command": "PYTHONPATH=src:. python3 tools/check_contact_sheet.py"
    }
  ],
  "fault_verification": {
    "command": "PYTHONPATH=src:. python3 tools/check_persistence_faults.py",
    "runs_in_subprocess": true,
    "isolated_data_root_per_scenario": true,
    "fault_classes": ["in-process OSError at os.replace", "SIGKILL of the service process"],
    "verdicts": ["NOT_COMMITTED", "COMMITTED", "INDETERMINATE"],
    "documentation": "FAULT_VERIFICATION.md"
  }
}
